Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; upgrade-insecure-requests"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^app/?$ app/index.html [L]
  RewriteRule ^android/?$ android/index.html [L]
  RewriteRule ^login/?$ login/index.html [L]
  RewriteRule ^signup/?$ signup/index.html [L]
  RewriteRule ^forgot-password/?$ forgot-password/index.html [L]
  RewriteRule ^update-password/?$ update-password/index.html [L]
  RewriteRule ^documents/?$ documents/index.html [L]
  RewriteRule ^privacy-policy/?$ privacy-policy/index.html [L]
  RewriteRule ^terms/?$ terms/index.html [L]
  RewriteRule ^settings/?$ /app/ [R=302,L]
</IfModule>
